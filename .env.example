# 账号管理服务器配置

# Flask环境
FLASK_ENV=production
DEBUG=False

# 服务器配置
PORT=5000
HOST=0.0.0.0

# JWT密钥（生产环境中应该使用强密钥）
JWT_SECRET_KEY=your-secret-key-here-change-this

# 数据库
DATABASE_URL=sqlite:///accounts.db

# 日志级别
LOG_LEVEL=INFO

# 允许的IP地址（逗号分隔）
ALLOWED_IPS=127.0.0.1,124.222.116.32

# 云端同步配置
CLOUD_SYNC_ENABLED=True
CLOUD_SYNC_INTERVAL=300

# SSL配置（可选）
SSL_CERT_PATH=
SSL_KEY_PATH=
