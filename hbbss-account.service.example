# HBBSS账号管理系统 - Systemd服务配置

# 创建此文件为: /etc/systemd/system/hbbss-account.service
# 然后运行以下命令:
#   sudo systemctl daemon-reload
#   sudo systemctl enable hbbss-account
#   sudo systemctl start hbbss-account
#   sudo systemctl status hbbss-account

[Unit]
Description=HBBSS Account Management Server
Documentation=https://github.com/HBBSS-software/Moodle--HBBSS-
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/hbbss-account-system

# 环境变量
Environment="FLASK_ENV=production"
Environment="DEBUG=False"
EnvironmentFile=/home/ubuntu/hbbss-account-system/.env

# Python虚拟环境
Environment="PATH=/home/ubuntu/hbbss-account-system/venv/bin"

# 执行命令
ExecStart=/home/ubuntu/hbbss-account-system/venv/bin/gunicorn \
    --workers 4 \
    --worker-class sync \
    --bind 127.0.0.1:5000 \
    --timeout 60 \
    --access-logfile /var/log/hbbss-account/access.log \
    --error-logfile /var/log/hbbss-account/error.log \
    --log-level info \
    server:app

# 自动重启
Restart=always
RestartSec=10
StartLimitInterval=600
StartLimitBurst=5

# 资源限制
LimitNOFILE=65535
LimitNPROC=65535

# 安全设置
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/home/ubuntu/hbbss-account-system/accounts.db \
              /var/log/hbbss-account

[Install]
WantedBy=multi-user.target
