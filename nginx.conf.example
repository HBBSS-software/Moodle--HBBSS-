# HBBSS账号管理系统 - Nginx配置示例

# 创建此文件为: /etc/nginx/sites-available/hbbss-account
# 然后运行: sudo ln -s /etc/nginx/sites-available/hbbss-account /etc/nginx/sites-enabled/
# 最后运行: sudo systemctl restart nginx

upstream hbbss_account {
    server 127.0.0.1:5000;
    keepalive 32;
}

# HTTP重定向到HTTPS（如果启用SSL）
server {
    listen 80;
    server_name 124.222.116.32;
    
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    
    location / {
        return 301 https://$server_name$request_uri;
    }
}

# HTTPS服务器（SSL证书可选）
server {
    listen 80;
    server_name 124.222.116.32;
    
    client_max_body_size 10M;
    
    # 启用gzip压缩
    gzip on;
    gzip_types text/plain text/css text/xml text/javascript application/json application/javascript application/xml+rss;
    gzip_min_length 1000;
    
    # 日志文件
    access_log /var/log/nginx/hbbss-account-access.log;
    error_log /var/log/nginx/hbbss-account-error.log;
    
    # 健康检查
    location /api/health {
        proxy_pass http://hbbss_account;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        access_log off;
    }
    
    # API代理
    location /api/ {
        proxy_pass http://hbbss_account;
        proxy_http_version 1.1;
        
        # 保持连接
        proxy_set_header Connection "";
        
        # 转发请求头
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        # 超时设置
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
        
        # 缓冲设置
        proxy_buffering on;
        proxy_buffer_size 4k;
        proxy_buffers 8 4k;
        
        # 错误处理
        proxy_intercept_errors on;
        error_page 502 503 504 /50x.html;
    }
    
    # 静态资源缓存
    location ~* \.(jpg|jpeg|png|gif|ico|css|js)$ {
        expires 7d;
        add_header Cache-Control "public, immutable";
    }
    
    # 首页
    location / {
        return 200 "HBBSS Account Management System - Ready\n";
        add_header Content-Type text/plain;
    }
    
    # 错误页面
    error_page 502 503 504 /50x.html;
    location = /50x.html {
        return 200 "Service temporarily unavailable. Please try again later.\n";
        add_header Content-Type text/plain;
    }
}

